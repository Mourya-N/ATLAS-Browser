# LAVRAY Cloud Backend Environment Configuration Example
# Copy to .env and populate real credentials. Never commit real .env files.

NODE_ENV=development
LAVRAY_BACKEND_HOST=0.0.0.0
LAVRAY_BACKEND_PORT=48080

# PostgreSQL & Redis (used by Docker Compose & backend)
POSTGRES_USER=lavray
POSTGRES_PASSWORD=change_me_in_dev_only
POSTGRES_DB=lavray_cloud
DATABASE_URL=postgresql://lavray:change_me_in_dev_only@postgres:5432/lavray_cloud
REDIS_URL=redis://redis:6379

# Authentication (MUST be >= 32 random chars in production)
LAVRAY_JWT_SECRET=dev-replace-with-32-plus-byte-random-secret-key
LAVRAY_JWT_ACCESS_TTL=900
LAVRAY_JWT_REFRESH_TTL=1209600

# AI Provider: 'gemini' or 'self_hosted' (Ollama / vLLM / llama.cpp OpenAI-compatible)
LAVRAY_AI_PROVIDER=gemini
GEMINI_API_KEY=
LAVRAY_AI_MODEL=gemini-2.5-flash

# Self-Hosted Model Runtime Configuration (e.g. http://127.0.0.1:11434/v1)
LAVRAY_SELF_HOSTED_URL=http://127.0.0.1:11434/v1
LAVRAY_SELF_HOSTED_MODEL=qwen2.5:7b-instruct
LAVRAY_SELF_HOSTED_API_KEY=

# External Search Providers (Official APIs; leave blank if unused)
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
BING_SEARCH_API_KEY=

# Development/Test flags (ignored / rejected in NODE_ENV=production)
LAVRAY_ALLOW_MOCK_SEARCH=false
LAVRAY_ALLOW_MOCK_AI=false

# Security & Rate Limiting
LAVRAY_RATE_LIMIT_PER_MIN=120
LAVRAY_SEARCH_RATE_LIMIT_PER_MIN=40
LAVRAY_FETCH_TIMEOUT_MS=8000
LAVRAY_MAX_FETCH_BYTES=2097152
LAVRAY_SEARCH_CACHE_TTL=180
LAVRAY_WORKER_POLL_MS=2000
LAVRAY_INLINE_WORKER=false
LAVRAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,file://
