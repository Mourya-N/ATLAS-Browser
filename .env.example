# Atlas Cloud Backend Environment Configuration Example
# Copy to .env and populate real credentials. Never commit real .env files.

NODE_ENV=development
ATLAS_BACKEND_HOST=0.0.0.0
ATLAS_BACKEND_PORT=48080

# PostgreSQL & Redis (used by Docker Compose & backend)
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change_me_in_dev_only
POSTGRES_DB=atlas_cloud
DATABASE_URL=postgresql://atlas:change_me_in_dev_only@postgres:5432/atlas_cloud
REDIS_URL=redis://redis:6379

# Authentication (MUST be >= 32 random chars in production)
ATLAS_JWT_SECRET=dev-replace-with-32-plus-byte-random-secret-key
ATLAS_JWT_ACCESS_TTL=900
ATLAS_JWT_REFRESH_TTL=1209600

# AI Provider (Optional; leave blank to run search-only without AI synthesis)
GEMINI_API_KEY=
ATLAS_AI_MODEL=gemini-2.5-flash

# External Search Providers (Official APIs; leave blank if unused)
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
BING_SEARCH_API_KEY=

# Development/Test flags (ignored / rejected in NODE_ENV=production)
ATLAS_ALLOW_MOCK_SEARCH=false
ATLAS_ALLOW_MOCK_AI=false

# Security & Rate Limiting
ATLAS_RATE_LIMIT_PER_MIN=120
ATLAS_SEARCH_RATE_LIMIT_PER_MIN=40
ATLAS_FETCH_TIMEOUT_MS=8000
ATLAS_MAX_FETCH_BYTES=2097152
ATLAS_SEARCH_CACHE_TTL=180
ATLAS_WORKER_POLL_MS=2000
ATLAS_INLINE_WORKER=false
ATLAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,file://
