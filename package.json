{
  "name": "atlas-browser",
  "version": "1.0.0",
  "description": "Atlas Browser — AI-Native Desktop Browser with Autonomous Agent Capabilities",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "Atlas Browser Team",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs && node scripts/build-backend.mjs",
    "build:desktop": "node scripts/build.mjs",
    "build:backend": "node scripts/build-backend.mjs",
    "backend:start": "node dist/backend/api/server.js",
    "backend:worker": "node dist/backend/worker-entrypoint.js",
    "backend:migrate": "node dist/backend/db/migrate-cli.js",
    "backend:eval": "node dist/backend/eval/search-eval.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.backend.json --noEmit",
    "start": "npm run build && node scripts/start.mjs",
    "test": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron ./node_modules/vitest/vitest.mjs run",
    "test:unit": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron ./node_modules/vitest/vitest.mjs run tests/unit",
    "test:integration": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron ./node_modules/vitest/vitest.mjs run tests/integration",
    "test:eval": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron ./node_modules/vitest/vitest.mjs run tests/eval",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:launch": "node tests/e2e/launch-built-app.mjs",
    "test:gemini": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron ./node_modules/vitest/vitest.mjs run tests/e2e/gemini-live.test.ts",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^13.2.0",
    "cron-parser": "^4.9.0",
    "ioredis": "5.4.1",
    "linkedom": "^0.18.5",
    "lucide-react": "^0.460.0",
    "pg": "8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "4.6.7",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.17.6",
    "@types/pg": "8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "com.atlasbrowser.app",
    "productName": "Atlas Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Atlas Browser uses the microphone when you activate voice commands in the AI panel."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network;WebBrowser"
    }
  }
}
